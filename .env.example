# Copy this file to `.env` and fill in local values. Never commit `.env`.
#
# Supabase: for local development run `npm run db:start`, then copy the API URL and the
# publishable (anon) key from `npm run db:status`. The publishable key is safe for the browser;
# the secret/service role key and AI/STT provider keys must only live in Supabase Edge Function
# secrets, never in this file.
SUPABASE_URL=
SUPABASE_KEY=
